# GEMINI_API_KEY: Required for Gemini AI API calls (set in Vercel Project Settings -> Environment Variables).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional default Gemini model ID (can also be switched in Admin Dashboard).
GEMINI_MODEL="gemini-4-hydrogen"

# ADMIN AUTHENTICATION (Server-Side Only — NEVER expose in frontend VITE_* variables)
# Optional overrides for Admin Panel login and HMAC session signing on Vercel.
ADMIN_EMAIL="azizul764244@gmail.com"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET="replace-with-random-32-plus-char-secret-for-vercel"
